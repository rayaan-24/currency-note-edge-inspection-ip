# ==============================================================================
# .gitignore - Currency Note Edge Quality Inspection
# ==============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Operating System Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor & IDE State
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary Archive Files
*.zip
*.tar
*.tar.gz

# Runtime Test Artifacts & Uploads (preserve .gitkeep)
results/*
!results/.gitkeep
uploads/*
!uploads/.gitkeep
